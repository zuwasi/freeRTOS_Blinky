#include <stdio.h>
#include <string.h>
#include <stdbool.h> // For bool type

/* Define a maximum string length to avoid potential buffer overflows.
 * MISRA C:2012 Dir 4.6, Rule 4.1 - Dynamic heap allocation shall not be used.
 * Using a fixed-size buffer on the stack instead.
 */
#define MAX_STRING_LENGTH 256

/* Replace exit() with a dedicated error handling mechanism.
 * This example uses a global flag, but other methods like a dedicated error handler function
 * or setting an error code in a struct are also possible.
 */
bool error_occurred = false;


/* Function to process a string.  Replaces original functionality. */
void process_string(const char *input_string) {
    /* Check for NULL pointer.  MISRA C:2012 Dir 4.12, Rule 4.12.1 */
    if (input_string == NULL) {
        /* Set the error flag. */
        error_occurred = true;
        return; // Return early to avoid further processing
    }

    /* Local string buffer.  Static allocation to comply with MISRA. */
    char local_string[MAX_STRING_LENGTH];

    /* Ensure string is null-terminated and fits in the buffer.
     * MISRA C:2012 Dir 4.7, Rule 4.7.1 - String handling functions shall be used to prevent buffer overflows.
     */
    size_t input_len = strnlen(input_string, MAX_STRING_LENGTH - 1); // -1 to leave space for null terminator
    if (input_len >= MAX_STRING_LENGTH) {
        error_occurred = true;
        return; // Return early
    }

    /* Copy the input string to the local buffer. */
    strncpy(local_string, input_string, input_len);
    local_string[input_len] = '\0'; // Ensure null termination


    /* Example string manipulation.  Replace with your original logic. */
    /* Avoid magic numbers. MISRA C:2012 Dir 2.7, Rule 2.7.1 */
    for (size_t i = 0; i < input_len; ++i) {  // Use size_t for indexing
        if (local_string[i] >= 'a' && local_string[i] <= 'z') {
            local_string[i] = local_string[i] - ('a' - 'A'); // Convert to uppercase
        }
    }

    /* Print the processed string. */
    printf("Processed string: %s\n", local_string);
}

int main() {
    /* Static allocation of the input string. */
    char input_string[MAX_STRING_LENGTH] = "Hello, world!";

    /* Process the string. */
    process_string(input_string);


    if (error_occurred) {
        // Handle the error in main.  In a bare-metal embedded system,
        // this might involve an infinite loop or a system reset.
        while(1); // Example: Infinite loop, replace with your error handling
    }

    return 0;
}
